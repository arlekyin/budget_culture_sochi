@echo off
chcp 65001 > nul
title Бюджет-Культура Сочи — работает

cd /d "%~dp0"

if not exist venv (
    echo  ОШИБКА: Система не установлена.
    echo  Сначала запустите файл УСТАНОВКА.bat
    pause
    exit /b 1
)

call venv\Scripts\activate.bat

echo.
echo  ================================================================
echo   Система "Бюджет-Культура Сочи" запускается...
echo.
echo   Сейчас автоматически откроется браузер.
echo   Если браузер не открылся — введите в адресную строку:
echo   http://127.0.0.1:8000
echo.
echo   ВАЖНО: не закрывайте это окно, пока работаете с системой!
echo   Для остановки нажмите Ctrl+C или просто закройте это окно.
echo  ================================================================
echo.

:: Небольшая пауза перед открытием браузера
timeout /t 2 /nobreak > nul
start "" "http://127.0.0.1:8000"

python manage.py runserver 2>&1
pause
